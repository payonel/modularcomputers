-- tail [-f] [-n [+]lines] [-c [+]bytes] [-N] [file...]: the last lines (10) or bytes of each file,
-- or of stdin; with +N, from line (or byte) N on. -f follows: once they're shown, it waits and shows
-- what's added to the files, until it's stopped (^C); not on stdin when it's a pipe, as tail.
local sys = require("sys")

local FOLLOW_SECONDS = 1 -- how long -f waits between looks (tail's --sleep-interval)
local READ_SIZE = 4096

local lines, bytes, from = 10, nil, false
local follow = false
local files = {}
local i = 1
while i <= #arg do
  local word = arg[i]
  local flag, value = string.match(word, "^%-([nc])(.*)$")
  if flag then
    if value == "" then
      i = i + 1
      value = arg[i] or ""
    end
    local plus = string.sub(value, 1, 1) == "+"
    local number = math.tointeger(tonumber(plus and string.sub(value, 2) or value))
    if not number or number < 0 then
      io.stderr:write("tail: invalid number of " .. (flag == "n" and "lines" or "bytes") .. ": '" .. value .. "'\n")
      return 1
    end
    from = plus
    if flag == "n" then
      lines, bytes = number, nil
    else
      bytes = number
    end
  elseif string.match(word, "^%-%d+$") then
    lines = tonumber(string.sub(word, 2))
  elseif word == "-f" then
    follow = true
  elseif string.sub(word, 1, 1) == "-" and #word > 1 then
    io.stderr:write("tail: invalid option -- '" .. string.sub(word, 2, 2) .. "'\n")
    return 1
  else
    files[#files + 1] = word
  end
  i = i + 1
end
if #files == 0 then
  files[1] = "-"
end

local function last(file)
  if bytes then
    local data = file:read("a") or ""
    if from then
      return string.sub(data, math.max(bytes, 1))
    end
    return bytes == 0 and "" or string.sub(data, -bytes)
  end
  local kept, n = {}, 0
  for line in file:lines("L") do
    n = n + 1
    if from then
      if n >= lines then
        io.write(line)
      end
    else
      kept[#kept + 1] = line
      if #kept > lines then
        table.remove(kept, 1) -- (a ring would be cheaper; the lines kept are few)
      end
    end
  end
  return table.concat(kept)
end

local status = 0
local followed = {} -- {path, file} each file to follow, left open
for index, path in ipairs(files) do
  local file, why = io.stdin, nil
  if path ~= "-" then
    file, why = io.open(path)
    local st = require("sys").stat(path)
    if file and st and st.type == "directory" then
      file:close()
      file, why = nil, path .. ": Is a directory" -- (its reads would fail: EISDIR)
    end
  end
  if not file then
    io.stderr:write("tail: " .. why .. "\n")
    status = 1
  else
    if #files > 1 then
      io.write(index > 1 and "\n" or "", "==> ", path == "-" and "standard input" or path, " <==\n")
    end
    io.write(last(file))
    if follow and file ~= io.stdin then
      followed[#followed + 1] = {path = path, file = file}
    elseif file ~= io.stdin then
      file:close()
    end
  end
end
if #followed == 0 then
  return status
end
-- -f: what the files grow by, as it comes (a header when it's another file's than the last shown)
io.stdout:flush()
local shown = followed[#followed].path
while true do
  sys.sleep(FOLLOW_SECONDS)
  for _, entry in ipairs(followed) do
    -- (the descriptor itself: a FILE's end of file is sticky, as glibc's is; tail reads past it)
    local data = sys.read(entry.file.fd, READ_SIZE)
    while data and data ~= "" do
      if #files > 1 and shown ~= entry.path then
        io.write("\n==> ", entry.path, " <==\n")
        shown = entry.path
      end
      io.write(data)
      data = sys.read(entry.file.fd, READ_SIZE)
    end
  end
  io.stdout:flush()
end
