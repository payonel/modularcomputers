-- lua [options] [script [args]]: Lua's standalone interpreter, as lua.c is: a program like any other
-- (the kernel runs it through /lib/ld.lua, as it runs every program), which runs Lua given as text.
-- -e stat runs a statement, -l mod (or -l g=mod) requires a module into a global, -i goes on to the
-- REPL after the script, -v prints the version, -E and -W are taken (nothing to do), -- ends the
-- options, - runs stdin. The script gets the arguments after it as arg (arg[0] the script, the
-- interpreter and its options at negative indices) and as its ...; what it returns is ignored, as
-- lua.c ignores it. With no script, the REPL when stdin is a terminal, else stdin as a script.
local sys = require("sys")

local PROGNAME = "lua"
local PROMPT, PROMPT2 = "> ", ">> "
local USAGE = [=[
usage: lua [options] [script [args]]
Available options are:
  -e stat   execute string 'stat'
  -i        enter interactive mode after executing 'script'
  -l mod    require library 'mod' into global 'mod'
  -l g=mod  require library 'mod' into global 'g'
  -v        show version information
  -E        ignore environment variables
  -W        turn warnings on
  --        stop handling options
  -         stop handling options and execute stdin
]=]

local argv = table.pack(...)

-- What an error object says, as lua.c's msghandler: a string, an object's __tostring, else its type.
local function message(err)
  if type(err) == "string" or math.type(err) then
    return tostring(err)
  end
  local meta = getmetatable(err)
  if type(meta) == "table" and meta.__tostring then
    local ok, text = pcall(tostring, err)
    if ok and type(text) == "string" then
      return text
    end
  end
  return "(error object is a " .. type(err) .. " value)"
end

-- The stack where an error happened, cut at this interpreter's xpcall (below it is its own and the
-- loader's, not the chunk's).
local function traceback()
  local lines = {}
  for line in string.gmatch(debug.traceback("", 3), "[^\n]+") do
    lines[#lines + 1] = line
  end
  local cut = #lines + 1
  for k = #lines, 1, -1 do
    if string.find(lines[k], "'xpcall'", 1, true) then
      cut = k
      break
    end
  end
  while cut > 2 and string.find(lines[cut - 1], "(...tail calls...)", 1, true) do
    cut = cut - 1
  end
  return "\n" .. table.concat(lines, "\n", 1, cut - 1)
end

-- A message on stderr, as lua.c's l_message: "lua: " first, except in the REPL.
local function report(text, interactive)
  io.stdout:flush()
  io.stderr:write(interactive and "" or PROGNAME .. ": ", text, "\n")
end

-- Calls f with its error reported (and its traceback); true and its results if it didn't fail.
local function docall(f, interactive, ...)
  local results = table.pack(xpcall(f, function(err)
    return message(err) .. traceback()
  end, ...))
  if not results[1] then
    report(results[2], interactive)
  end
  return table.unpack(results, 1, results.n)
end

local function dochunk(chunk, err)
  if not chunk then
    report(err)
    return false
  end
  return (docall(chunk))
end

local function repl()
  while true do
    io.stdout:write(PROMPT)
    local line = io.read("L")
    if not line then
      io.stdout:write("\n")
      return
    end
    local chunk, err = load("return " .. line, "=stdin")
    if not chunk then
      chunk, err = load(line, "=stdin")
      while not chunk and string.find(err, "<eof>$") do
        io.stdout:write(PROMPT2)
        local more = io.read("L")
        if not more then
          break
        end
        line = line .. more
        chunk, err = load(line, "=stdin")
      end
    end
    if not chunk then
      report(err, true)
    else
      local results = table.pack(docall(chunk, true))
      if results[1] and results.n > 1 then
        print(table.unpack(results, 2, results.n))
      end
    end
  end
end

-- The options, as lua.c's collectargs: where the script is (nil: none), and what was asked for.
local script, interactive, version, stdin
local i = 1
while i <= argv.n do
  local a = argv[i]
  if a == "--" then
    i = i + 1
    break
  elseif a == "-" then
    stdin = true
    break
  elseif string.sub(a, 1, 1) ~= "-" then
    break
  elseif a == "-i" then
    interactive, version = true, true
  elseif a == "-v" then
    version = true
  elseif a == "-E" or a == "-W" then
    -- (nothing to ignore; warnings go nowhere yet)
  elseif a == "-e" or a == "-l" then
    if i == argv.n then
      io.stderr:write(PROGNAME, ": '", a, "' needs argument\n", USAGE)
      return 1
    end
    i = i + 1
  elseif (string.sub(a, 1, 2) == "-e" or string.sub(a, 1, 2) == "-l") and #a > 2 then
    -- (its argument joined to it)
  else
    io.stderr:write(PROGNAME, ": unrecognized option '", a, "'\n", USAGE)
    return 1
  end
  i = i + 1
end
if i <= argv.n and not stdin then
  script = i
end

-- arg: the script at 0, what follows it after, the interpreter and its options before
local first = script or (stdin and i) or argv.n + 1
_G.arg = {[-first] = PROGNAME}
for k = 1, argv.n do
  arg[k - first] = argv[k]
end

if version then
  io.stdout:write(_VERSION, " (mcos)\n")
end

-- -e and -l, in their order
local k = 1
while k < first do
  local a = argv[k]
  local option, value = string.sub(a, 1, 2), string.sub(a, 3)
  if (option == "-e" or option == "-l") and value == "" then
    k = k + 1
    value = argv[k]
  end
  if option == "-e" then
    if not dochunk(load(value, "=(command line)")) then
      return 1
    end
  elseif option == "-l" then
    local global, module = string.match(value, "^([^=]+)=(.+)$")
    global, module = global or value, module or value
    local ok, loaded = docall(require, false, module)
    if not ok then
      return 1
    end
    _G[global] = loaded
  end
  k = k + 1
end

if script then
  local chunk, err = loadfile(argv[script])
  if not chunk then
    report(err)
    return 1
  end
  if not docall(chunk, false, table.unpack(argv, script + 1, argv.n)) then
    return 1
  end
elseif stdin then
  if not dochunk(load(io.read("a"), "=stdin")) then
    return 1
  end
end

if interactive then
  repl()
elseif not script and not stdin and first > argv.n then
  -- nothing given: the REPL at a terminal, else stdin as a script
  local ran = false
  for n = 1, first - 1 do
    local option = string.sub(argv[n], 1, 2)
    if option == "-e" or option == "-v" then
      ran = true
    end
  end
  if not ran then
    if sys.isatty(0) then
      io.stdout:write(_VERSION, " (mcos)\n")
      repl()
    elseif not dochunk(load(io.read("a"), "=stdin")) then
      return 1
    end
  end
end
return 0
