-- ls [-1aClF] [path...]: what's in directories (a file lists itself). On a terminal, names go in
-- columns down then across, as wide as the terminal (as GNU ls), directories in blue; into a pipe or
-- a file, one a line. -1 one a line, -C columns anyway, -l long (type, size, name; a link's target
-- after ->), -a names starting with a dot too, -F a / after directories, an @ after links.
local sys = require("sys")
local fs = require("fs")

local GAP = 2 -- spaces between columns
local DEFAULT_WIDTH = 80 -- columns, when the terminal doesn't say
local DIRECTORY_COLOR = "\27[1;34m" -- (dircolors' default for directories)
local LINK_COLOR = "\27[1;36m" -- (and for links)
local RESET = "\27[0m"

local flags = {}
local paths = {}
for _, word in ipairs(arg) do
  if string.sub(word, 1, 1) == "-" and #word > 1 then
    for c in string.gmatch(string.sub(word, 2), ".") do
      if not string.find("1aClF", c, 1, true) then
        io.stderr:write("ls: invalid option -- '" .. c .. "'\n")
        return 2
      end
      flags[c] = true
    end
  else
    paths[#paths + 1] = word
  end
end
if #paths == 0 then
  paths[1] = "."
end

local tty = sys.isatty(1)
local columns = flags.C or (tty and not flags["1"] and not flags.l)
local width = tty and sys.ioctl(1, "TIOCGWINSZ") or DEFAULT_WIDTH

-- An entry as shown: its text, and how wide it is on the screen (colors take no room).
local function shown(entry)
  local mark = flags.F and (entry.type == "directory" and "/" or entry.type == "link" and "@") or ""
  local text = entry.name .. mark
  local color = entry.type == "directory" and DIRECTORY_COLOR or entry.type == "link" and LINK_COLOR
  if tty and color then
    return color .. text .. RESET, utf8.len(text) or #text
  end
  return text, utf8.len(text) or #text
end

-- Names in columns: as many columns as fit, filled down first.
local function grid(entries)
  local texts, widths = {}, {}
  for i, entry in ipairs(entries) do
    texts[i], widths[i] = shown(entry)
  end
  local n = #entries
  if n == 0 then
    return
  end
  local rows, colwidths
  for tried = n, 1, -1 do
    rows = math.ceil(n / tried)
    local cols = math.ceil(n / rows)
    colwidths = {}
    local total = 0
    for c = 1, cols do
      local widest = 0
      for r = 1, rows do
        local i = (c - 1) * rows + r
        if i <= n and widths[i] > widest then
          widest = widths[i]
        end
      end
      colwidths[c] = widest
      total = total + widest + (c < cols and GAP or 0)
    end
    if total <= width or cols == 1 then
      break
    end
  end
  for r = 1, rows do
    local line = {}
    for c = 1, #colwidths do
      local i = (c - 1) * rows + r
      if i <= n then
        local last = (c == #colwidths) or ((c * rows + r) > n)
        line[#line + 1] = texts[i] .. (last and "" or string.rep(" ", colwidths[c] - widths[i] + GAP))
      end
    end
    io.write(table.concat(line), "\n")
  end
end

local function show(entries, dir)
  local visible = {}
  for _, entry in ipairs(entries) do
    if flags.a or string.sub(entry.name, 1, 1) ~= "." then
      visible[#visible + 1] = entry
    end
  end
  if flags.l then
    for _, entry in ipairs(visible) do
      local st = dir and fs.lstat(fs.join(dir, entry.name)) or entry
      local kind = ({directory = "d", device = "c", fifo = "p", link = "l"})[st and st.type or entry.type] or "-"
      local text = shown(entry)
      local target = st and st.target and " -> " .. st.target or ""
      io.write(string.format("%s %8d %s%s\n", kind, st and st.size or 0, text, target))
    end
  elseif columns then
    grid(visible)
  else
    for _, entry in ipairs(visible) do
      io.write((shown(entry)), "\n")
    end
  end
end

local status = 0
local files, dirs = {}, {}
for _, path in ipairs(paths) do
  local st, why = fs.stat(path)
  local link = fs.lstat(path)
  if link and link.type == "link" and (flags.l or not st) then
    st = link -- (-l shows a link named on the command line as itself, as does a link to nothing)
  end
  if not st then
    io.stderr:write("ls: cannot access '" .. path .. "': " .. string.gsub(why, "^.-: ", "") .. "\n")
    status = 2
  elseif st.type == "directory" then
    dirs[#dirs + 1] = path
  else
    files[#files + 1] = {name = path, type = st.type, size = st.size, target = st.target}
  end
end
if #files > 0 then
  show(files)
end
for i, path in ipairs(dirs) do
  if #paths > 1 then
    io.write((#files > 0 or i > 1) and "\n" or "", path, ":\n")
  end
  local entries, err = fs.list(path)
  if entries then
    show(entries, path)
  else
    io.stderr:write("ls: " .. err .. "\n")
    status = 2
  end
end
return status
