-- kill [-SIGNAL | -s SIGNAL] [--] pid...: sends a signal to processes (SIGTERM by default). A
-- signal is a name (TERM, SIGTERM, KILL...) or its number (-9); a negative pid is a process group
-- (after --, so it isn't read as a signal). kill -l lists the signals.
local sys = require("sys")

local signal = "SIGTERM"
local signals = sys.SIGNALS

-- A signal's name from what was given: a name with or without SIG, or a number; nil if none.
local function named(given)
  local number = math.tointeger(tonumber(given))
  if number then
    for name, n in pairs(signals) do
      if n == number then
        return name
      end
    end
    return nil
  end
  local name = string.upper(given)
  name = string.sub(name, 1, 3) == "SIG" and name or "SIG" .. name
  return signals[name] and name or nil
end

local pids = {}
local i = 1
while i <= #arg do
  local word = arg[i]
  if word == "--" then
    for k = i + 1, #arg do
      pids[#pids + 1] = arg[k]
    end
    break
  elseif word == "-l" then
    local names = {}
    for name, n in pairs(signals) do
      names[#names + 1] = {n, string.sub(name, 4)}
    end
    table.sort(names, function(a, b)
      return a[1] < b[1]
    end)
    for _, pair in ipairs(names) do
      io.write(string.format("%2d) %s\n", pair[1], pair[2]))
    end
    return 0
  elseif word == "-s" or (#pids == 0 and string.sub(word, 1, 1) == "-" and #word > 1) then
    local given = word == "-s" and arg[i + 1] or string.sub(word, 2)
    if word == "-s" then
      i = i + 1
    end
    signal = given and named(given)
    if not signal then
      io.stderr:write("kill: ", tostring(given), ": invalid signal specification\n")
      return 1
    end
  else
    pids[#pids + 1] = word
  end
  i = i + 1
end
if #pids == 0 then
  io.stderr:write("kill: usage: kill [-s sigspec | -signum | -sigspec] pid ...\n")
  return 2
end

local status = 0
for _, word in ipairs(pids) do
  local pid = math.tointeger(tonumber(word))
  if not pid then
    io.stderr:write("kill: ", word, ": arguments must be process or job IDs\n")
    status = 1
  else
    local ok, why = sys.kill(pid, signal)
    if not ok then
      io.stderr:write("kill: (", word, ") - ", why, "\n")
      status = 1
    end
  end
end
return status
