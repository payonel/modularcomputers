-- sh: the shell, after POSIX sh. Only shell behavior lives here: commands are programs (in /bin,
-- found through PATH, or named by a path), and the builtins are what has to change the shell itself.
--
--   words      'single', "double" (with $ and ` inside), \x; ~ at a word's start is HOME
--   expansion  $NAME ${NAME} $? $$ $! $# $@ $* $0..$9, ${NAME:-word} ${NAME-word} ${NAME:=word}
--              ${NAME:+word} ${NAME:?word} ${#NAME}; $(command) and `command` (their output, the
--              new lines at its end dropped); unquoted results split into fields on IFS; then globs
--              (* ? [...]) on what isn't quoted, a word matching nothing kept as it is
--   commands   NAME=value (the shell's, or that command's environment only), ! pipeline, |, &&, ||,
--              ;, & (in the background, ignoring ^C, as without job control), new lines
--   redirects  < > >> n< n> n>> n>&m n<&m n>&-
--   builtins   cd [-|dir], pwd, exit [n], export [NAME[=value]...], unset NAME..., . file, source
--              file, alias [name[=value]...], unalias name..., read [NAME...], set, type name...,
--              true, false, :
--   prompts    PS1 (default "\w \$ ": \w the working directory, ~ for HOME; \W its last part; \$;
--              \n; \\), PS2 ("> ") while a line goes on (an open quote, a trailing | && || or \)
--
-- Errors go to stderr as "sh: <what>: <why>". Status: a command not found 127; found but not
-- runnable (a directory) 126; a redirection that fails 1 (its command doesn't run); a syntax error 2
-- (a script stops there; at the prompt nothing on the line runs); a command ended by a signal 128 +
-- its number. sh -c 'command' [name [args...]] and sh script [args...] run those; interactive on a
-- tty, ^C drops the line being typed or ends the command in front, and end of file (^D) exits.
local sys = require("sys")
local fs = require("fs")

local DEFAULT_PS1 = "\\w \\$ "
local DEFAULT_PS2 = "> "
local DEFAULT_IFS = " \t\n"
local NOT_FOUND, NOT_RUNNABLE, SYNTAX, SIGNALED = 127, 126, 2, 128

-- The shell's variables (all exported: children get them), aliases, positional parameters.
local vars = {}
for name, value in pairs(io.environ()) do
  vars[name] = value
end
local aliases = {}
local positional = {n = 0}
local name0 = "sh"
local status = 0 -- $?
local lastbg = nil -- $!
local interactive = false -- reading commands at a terminal (not -c, not a script)

local function say(text)
  io.stdout:flush()
  io.stderr:write("sh: " .. text .. "\n")
end

local function environment()
  local env = {}
  for name, value in pairs(vars) do
    env[name] = value
  end
  return env
end

-- ---- lexing -------------------------------------------------------------------------------------
-- A line becomes tokens: words, each a list of parts ({text, quoted} literal text, {var, op, arg,
-- quoted}, {cmd = text, quoted}, {tilde}), redirections ({redirect, fd, to}) and operators ({op}),
-- each with where it is in the line (from, last). An incomplete line (an open quote, an open $(, a
-- trailing | && || or \) is INCOMPLETE, so the caller can read more.
--
-- Aliases are expanded here, as POSIX has it: a command's name (its first word, after any
-- assignments), unquoted, that's an alias is replaced in the line by the alias's text, which is
-- lexed in its place (so it may hold operators: alias l='ls | head'); an alias isn't expanded again
-- inside its own text, and one whose text ends in a blank makes the next word a command name too.
-- The lexer gives back the line as it ended up (aliases in it), which the tokens' places refer to.

local INCOMPLETE = setmetatable({}, {__name = "INCOMPLETE"})

local OPERATORS = {"&&", "||", ";", "&", "|", "!"}

-- Where the ) closing a $( whose text starts at 'at' is (quotes, nested $( and backticks skipped).
local function closing(line, at)
  local depth = 1
  local i = at
  while i <= #line do
    local c = string.sub(line, i, i)
    if c == "\\" then
      i = i + 2
    elseif c == "'" then
      local close = string.find(line, "'", i + 1, true)
      if not close then
        return nil
      end
      i = close + 1
    elseif c == '"' then
      i = i + 1
      while i <= #line and string.sub(line, i, i) ~= '"' do
        i = i + (string.sub(line, i, i) == "\\" and 2 or 1)
      end
      if i > #line then
        return nil
      end
      i = i + 1
    elseif c == "`" then
      local close = string.find(line, "`", i + 1, true)
      if not close then
        return nil
      end
      i = close + 1
    elseif c == "(" then
      depth = depth + 1
      i = i + 1
    elseif c == ")" then
      depth = depth - 1
      if depth == 0 then
        return i
      end
      i = i + 1
    else
      i = i + 1
    end
  end
end

-- A $ at 'at': its part and where the line goes on; INCOMPLETE; nil and why (bad substitution);
-- or nil (a $ that's just a $).
local function dollar(line, at, quoted)
  local nxt = string.sub(line, at + 1, at + 1)
  if nxt == "(" then
    local close = closing(line, at + 2)
    if not close then
      return INCOMPLETE
    end
    return {cmd = string.sub(line, at + 2, close - 1), quoted = quoted}, close + 1
  elseif nxt == "{" then
    local close = string.find(line, "}", at + 2, true)
    if not close then
      return INCOMPLETE
    end
    local body = string.sub(line, at + 2, close - 1)
    local length = string.match(body, "^#([%w_]+)$")
    if length then
      return {var = length, op = "#", quoted = quoted}, close + 1
    end
    local name, op, arg = string.match(body, "^([%w_]+)(:?[%-=+?])(.*)$")
    if name then
      return {var = name, op = op, arg = arg, quoted = quoted}, close + 1
    end
    name = string.match(body, "^([%w_]+)$") or string.match(body, "^([%?%$#@%*!])$")
    if not name then
      return nil, "${" .. body .. "}: bad substitution"
    end
    return {var = name, quoted = quoted}, close + 1
  end
  local name = string.match(line, "^[%a_][%w_]*", at + 1) or string.match(line, "^[%d%?%$#@%*!]", at + 1)
  if name then
    return {var = name, quoted = quoted}, at + 1 + #name
  end
end

local function lex(line, noalias)
  local tokens = {}
  local parts, inword = {}, false
  local i, n = 1, #line
  local wordstart = 1
  local active = {} -- aliases being expanded: {name, upto (where its text ends)}
  local after = nil -- where an alias ending in a blank ends: the word there is a command name too
  -- Whether the word being finished is a command's name: first since an operator, past assignments.
  local function commandname()
    if after and wordstart >= after then
      after = nil
      return true
    end
    for k = #tokens, 1, -1 do
      local t = tokens[k]
      if t.op then
        return true
      end
      local first = t.word and t.word[1]
      if not (first and first.text and not first.quoted and string.match(first.text, "^[%a_][%w_]*=")) then
        return false
      end
    end
    return true
  end
  local function expanding(name)
    for _, a in ipairs(active) do
      if a.name == name and wordstart <= a.upto then
        return true
      end
    end
    return false
  end
  local function text(t, quoted)
    local last = parts[#parts]
    if last and last.text and last.quoted == quoted then
      last.text = last.text .. t
    else
      parts[#parts + 1] = {text = t, quoted = quoted}
    end
    inword = true
  end
  -- Ends the word being read; true if it was an alias, put in its place (lexing goes on from there).
  local function finish()
    if inword then
      local only = parts[1]
      local name = #parts == 1 and only.text and not only.quoted and only.text
      local value = name and not noalias and aliases[name]
      if value and commandname() and not expanding(name) then
        line = string.sub(line, 1, wordstart - 1) .. value .. string.sub(line, i)
        local delta = #value - (i - wordstart)
        for _, a in ipairs(active) do
          if a.upto >= wordstart then
            a.upto = a.upto + delta
          end
        end
        active[#active + 1] = {name = name, upto = wordstart + #value - 1}
        after = string.find(value, "[ \t]$") and wordstart + #value or nil
        n, i = #line, wordstart
        parts, inword = {}, false
        return true
      end
      tokens[#tokens + 1] = {word = parts, from = wordstart, last = i - 1}
    end
    parts, inword = {}, false
  end
  while i <= n do
    local c = string.sub(line, i, i)
    if not inword then
      wordstart = i
    end
    if c == "\\" then
      if i == n then
        return INCOMPLETE -- a line ending in \ goes on
      end
      local d = string.sub(line, i + 1, i + 1)
      if d ~= "\n" then -- (\ and a new line: the line goes on, both gone)
        text(d, true)
      end
      i = i + 2
    elseif c == "'" then
      local close = string.find(line, "'", i + 1, true)
      if not close then
        return INCOMPLETE
      end
      text(string.sub(line, i + 1, close - 1), true)
      i = close + 1
    elseif c == '"' then
      i = i + 1
      text("", true)
      while true do
        if i > n then
          return INCOMPLETE
        end
        local d = string.sub(line, i, i)
        if d == '"' then
          i = i + 1
          break
        elseif d == "\\" and string.find(string.sub(line, i + 1, i + 1), '[\\"$`\n]') then
          text(string.sub(line, i + 1, i + 1), true)
          i = i + 2
        elseif d == "$" then
          local part, after = dollar(line, i, true)
          if part == INCOMPLETE then
            return INCOMPLETE
          elseif part then
            parts[#parts + 1] = part
            i = after
          elseif after then
            return nil, after
          else
            text("$", true)
            i = i + 1
          end
        elseif d == "`" then
          local close = string.find(line, "`", i + 1, true)
          if not close then
            return INCOMPLETE
          end
          parts[#parts + 1] = {cmd = string.sub(line, i + 1, close - 1), quoted = true}
          i = close + 1
        else
          text(d, true)
          i = i + 1
        end
      end
    elseif c == "$" then
      local part, after = dollar(line, i, false)
      if part == INCOMPLETE then
        return INCOMPLETE
      elseif part then
        parts[#parts + 1] = part
        inword = true
        i = after
      elseif after then
        return nil, after
      else
        text("$", false)
        i = i + 1
      end
    elseif c == "`" then
      local close = string.find(line, "`", i + 1, true)
      if not close then
        return INCOMPLETE
      end
      parts[#parts + 1] = {cmd = (string.gsub(string.sub(line, i + 1, close - 1), "\\([`\\$])", "%1")), quoted = false}
      inword = true
      i = close + 1
    elseif c == "~" and not inword and (i == n or string.find(string.sub(line, i + 1, i + 1), "[/ \t\n;|&]")) then
      parts[#parts + 1] = {tilde = true}
      inword = true
      i = i + 1
    elseif c == " " or c == "\t" then
      if finish() then
        goto continue
      end
      i = i + 1
    elseif c == "\n" then
      if finish() then
        goto continue
      end
      local last = tokens[#tokens]
      if not (last and (last.op == "|" or last.op == "&&" or last.op == "||")) then
        tokens[#tokens + 1] = {op = ";", from = i, last = i} -- (after | && || a new line just goes on)
      end
      i = i + 1
    elseif c == "#" and not inword then
      while i <= n and string.sub(line, i, i) ~= "\n" do
        i = i + 1
      end
    else
      -- a redirection: [n]< [n]> [n]>> [n]>&m [n]<&m [n]>&-
      local digits = inword and #parts == 1 and parts[1].quoted == false and string.match(parts[1].text, "^%d+$")
      local op, target = string.match(line, "^([<>])&([%d%-]+)", i)
      if not op then
        op = string.match(line, "^>>", i) or string.match(line, "^[<>]", i)
      end
      if op and (not inword or digits) then
        local fd
        local start = digits and wordstart or i
        if digits then
          fd = tonumber(digits)
          parts, inword = {}, false
        end
        if finish() then
          goto continue
        end
        if target then
          tokens[#tokens + 1] = {redirect = op .. "&", fd = fd, to = target, from = start, last = i + #op + #target}
          i = i + #op + 1 + #target
        else
          tokens[#tokens + 1] = {redirect = op, fd = fd, from = start, last = i + #op - 1}
          i = i + #op
        end
      elseif op then
        if finish() then -- a>b: the word, then the redirection
          goto continue
        end
      else
        local found
        for _, candidate in ipairs(OPERATORS) do
          if string.sub(line, i, i + #candidate - 1) == candidate then
            found = candidate
            break
          end
        end
        -- ! is an operator only as a word of its own
        if found == "!" and (inword or not string.find(string.sub(line, i + 1, i + 1), "^[ \t]")) then
          found = nil
        end
        if found then
          if finish() then
            goto continue
          end
          tokens[#tokens + 1] = {op = found, from = i, last = i + #found - 1}
          i = i + #found
        else
          text(c, false)
          i = i + 1
        end
      end
    end
    ::continue::
    if i > n and inword then
      finish() -- (a word at the line's end: if it was an alias, its text is lexed next)
    end
  end
  finish()
  local last = tokens[#tokens]
  if last and (last.op == "|" or last.op == "&&" or last.op == "||") then
    return INCOMPLETE -- a line ending in | && || goes on
  end
  return tokens, nil, line
end

-- ---- parsing ------------------------------------------------------------------------------------
-- tokens -> lists: {pipelines = {{commands, negate, next = "&&" | "||"}...}, background}; a command:
-- {assigns = {{name, word}}, words, redirects = {{op, fd, word | to}}}. Syntax errors as bash says
-- them: "syntax error near unexpected token `|'".

local function syntax(token)
  local shown = token and (token.op or token.redirect) or "newline"
  return nil, "syntax error near unexpected token `" .. shown .. "'"
end

local function parse(tokens)
  local lists, i = {}, 1
  local function command()
    local cmd = {assigns = {}, words = {}, redirects = {}}
    while tokens[i] do
      local t = tokens[i]
      if t.word then
        local first = t.word[1]
        local name = #cmd.words == 0 and first and first.text and not first.quoted
          and string.match(first.text, "^([%a_][%w_]*)=")
        if name then
          local value = {}
          for k, part in ipairs(t.word) do
            value[k] = part
          end
          value[1] = {text = string.sub(first.text, #name + 2), quoted = false}
          cmd.assigns[#cmd.assigns + 1] = {name = name, word = value}
        else
          cmd.words[#cmd.words + 1] = t.word
        end
        i = i + 1
      elseif t.redirect then
        if string.sub(t.redirect, -1) == "&" then
          cmd.redirects[#cmd.redirects + 1] = {op = t.redirect, fd = t.fd, to = t.to}
          i = i + 1
        else
          local target = tokens[i + 1]
          if not (target and target.word) then
            return syntax(target)
          end
          cmd.redirects[#cmd.redirects + 1] = {op = t.redirect, fd = t.fd, word = target.word}
          i = i + 2
        end
      else
        break
      end
    end
    if #cmd.words == 0 and #cmd.assigns == 0 and #cmd.redirects == 0 then
      return syntax(tokens[i])
    end
    return cmd
  end
  while tokens[i] do
    if tokens[i].op == ";" and (i == 1 or tokens[i - 1].op == ";") then
      i = i + 1 -- (empty lines)
    else
      local list = {pipelines = {}, from = tokens[i].from}
      while true do
        local pipeline = {commands = {}}
        if tokens[i] and tokens[i].op == "!" then
          pipeline.negate = true
          i = i + 1
        end
        while true do
          local cmd, why = command()
          if not cmd then
            return nil, why
          end
          pipeline.commands[#pipeline.commands + 1] = cmd
          if tokens[i] and tokens[i].op == "|" then
            i = i + 1
          else
            break
          end
        end
        list.pipelines[#list.pipelines + 1] = pipeline
        local t = tokens[i]
        if t and (t.op == "&&" or t.op == "||") then
          pipeline.next = t.op
          i = i + 1
        else
          break
        end
      end
      local t = tokens[i]
      list.last = tokens[i - 1].last
      if t and (t.op == ";" or t.op == "&") then
        list.background = t.op == "&"
        i = i + 1
      elseif t then
        return syntax(t)
      end
      lists[#lists + 1] = list
    end
  end
  return lists
end

-- ---- expansion ----------------------------------------------------------------------------------

local function variable(name)
  if name == "?" then
    return tostring(status)
  elseif name == "$" then
    return tostring(sys.getpid())
  elseif name == "!" then
    return lastbg and tostring(lastbg) or nil
  elseif name == "#" then
    return tostring(positional.n)
  elseif name == "@" or name == "*" then
    -- (joined with IFS's first character, as "$*" is: a space with IFS unset, nothing with it empty)
    local ifs = vars.IFS
    return table.concat(positional, ifs == nil and " " or string.sub(ifs, 1, 1), 1, positional.n)
  elseif name == "0" then
    return name0
  elseif string.match(name, "^%d$") then
    return positional[tonumber(name)]
  end
  return vars[name]
end

-- $(command): its output, as a child shell writes it, with the new lines at its end dropped; $? is
-- its status.
-- Command substitutions run so far (an assignment's status is its last one's).
local substitutions = 0

local function substitute(text)
  local r, w = sys.pipe()
  if not r then
    error({shell = "cannot make a pipe: " .. tostring(w)}, 0)
  end
  io.stdout:flush()
  local pid, why = sys.spawn("/bin/sh", {"-c", text}, {fds = {[1] = w}, env = environment()})
  sys.close(w)
  if not pid then
    sys.close(r)
    error({shell = "/bin/sh: " .. tostring(why)}, 0)
  end
  local out = {}
  while true do
    local data = sys.read(r, 4096)
    if not data or data == "" then
      break
    end
    out[#out + 1] = data
  end
  sys.close(r)
  local _, how, value = sys.waitpid(pid)
  status = how == "exited" and value or SIGNALED + (sys.SIGNALS[value] or 0)
  substitutions = substitutions + 1
  return (string.gsub(table.concat(out), "\n+$", ""))
end

local expandword

-- A ${NAME op word}'s word, expanded as one string.
local function argument(arg)
  local tokens = lex(arg, true)
  if tokens == INCOMPLETE or not tokens then
    return arg
  end
  local words = {}
  for _, t in ipairs(tokens) do
    if t.word then
      words[#words + 1] = expandword(t.word, true)[1]
    end
  end
  return table.concat(words, " ")
end

local function parameter(part)
  local value = variable(part.var)
  local op = part.op
  if op == "#" then
    return tostring(#(value or ""))
  elseif not op then
    return value
  end
  local unset = value == nil or (string.sub(op, 1, 1) == ":" and value == "")
  local kind = string.sub(op, -1)
  if kind == "-" then
    return unset and argument(part.arg) or value
  elseif kind == "=" then
    if unset then
      value = argument(part.arg)
      vars[part.var] = value
    end
    return value
  elseif kind == "+" then
    return unset and "" or argument(part.arg)
  elseif kind == "?" then
    if unset then
      error({shell = part.var .. ": " .. (part.arg ~= "" and argument(part.arg) or "parameter not set"), fatal = true}, 0)
    end
    return value
  end
end

local GLOB_SPECIAL = "[%*%?%[%]\\]"

-- A word's fields: its parts expanded, unquoted expansions split on IFS, then globbed where
-- unquoted * ? [ are. 'single': one string, no splitting or globs (an assignment's value).
function expandword(word, single)
  local fields = {}
  local pattern, plain, globbed, exists = {}, {}, false, false
  local function add(text, quoted)
    plain[#plain + 1] = text
    if quoted then
      pattern[#pattern + 1] = (string.gsub(text, GLOB_SPECIAL, "\\%0"))
    else
      pattern[#pattern + 1] = text
      if string.find(text, "[%*%?%[]") then
        globbed = true
      end
    end
    exists = true
  end
  local function close()
    if exists then
      fields[#fields + 1] = {pattern = table.concat(pattern), plain = table.concat(plain), globbed = globbed}
    end
    pattern, plain, globbed, exists = {}, {}, false, false
  end
  local ifs = vars.IFS or DEFAULT_IFS
  for _, part in ipairs(word) do
    if part.text then
      add(part.text, part.quoted)
    elseif part.tilde then
      add(vars.HOME or "/", true)
    elseif part.var == "@" and part.quoted and not single then
      -- "$@": each parameter a field of its own
      for k = 1, positional.n do
        if k > 1 then
          close()
        end
        add(positional[k], true)
      end
    else
      local value
      if part.cmd then
        value = substitute(part.cmd)
      else
        value = parameter(part)
      end
      if value then
        if part.quoted or single or ifs == "" then
          add(value, true)
        else
          -- field splitting: runs of IFS characters separate fields
          local separators = "[" .. string.gsub(ifs, "%W", "%%%0") .. "]+"
          local at = 1
          while at <= #value do
            local s, e = string.find(value, separators, at)
            if not s then
              add(string.sub(value, at), false)
              break
            end
            if s > at then
              add(string.sub(value, at, s - 1), false)
            end
            close()
            at = e + 1
          end
        end
      elseif part.quoted then
        add("", true)
      end
    end
  end
  close()
  local words = {}
  for _, field in ipairs(fields) do
    local matches = (field.globbed and not single) and fs.glob(field.pattern) or {}
    if #matches == 0 then
      words[#words + 1] = field.plain
    end
    for _, match in ipairs(matches) do
      words[#words + 1] = match
    end
  end
  if single and #words == 0 then
    words[1] = ""
  end
  return words
end

-- ---- running ------------------------------------------------------------------------------------

local builtins = {}

-- Where a command's program is: the path it names (with a /), or the first in PATH; else nil, the
-- status and why.
local function locate(name)
  if string.find(name, "/", 1, true) then
    local st, why = sys.stat(name)
    if not st then
      return nil, NOT_FOUND, name .. ": " .. why
    elseif st.type == "directory" then
      return nil, NOT_RUNNABLE, name .. ": Is a directory"
    end
    return name
  end
  for dir in string.gmatch(vars.PATH or "", "[^:]+") do
    local file = fs.join(dir, name)
    local st = sys.stat(file)
    if st and st.type ~= "directory" then
      return file
    end
  end
  return nil, NOT_FOUND, name .. ": not found"
end

-- Whether an fd of the shell's is open.
local function isopen(fd)
  local copy = sys.dup(fd)
  if copy then
    sys.close(copy)
    return true
  end
  return false
end

-- Opens a command's redirections: the fds it gets ({[child fd] = an fd of ours, or false: closed})
-- and the files opened for them (in 'opened', to close once it's started); nil and why when one
-- fails.
local function redirect(cmd, fds, opened)
  for _, r in ipairs(cmd.redirects) do
    local op = r.op
    local fd = r.fd or (string.sub(op, 1, 1) == "<" and 0 or 1)
    if string.sub(op, -1) == "&" then
      if r.to == "-" then
        fds[fd] = false
      else
        local from = tonumber(r.to)
        local source = fds[from]
        if source == nil then
          source = isopen(from) and from or false
        end
        if source == false then
          return nil, r.to .. ": Bad file descriptor"
        end
        fds[fd] = source
      end
    else
      local words = expandword(r.word)
      if #words ~= 1 then
        return nil, (#words == 0 and "" or table.concat(words, " ")) .. ": ambiguous redirect"
      end
      local mode = op == "<" and "r" or op == ">>" and "a" or "w"
      local file, why = sys.open(words[1], mode)
      if not file then
        return nil, words[1] .. ": " .. why
      end
      opened[#opened + 1] = file
      fds[fd] = file
    end
  end
  return true
end

-- How a child's end reads as a status.
local function statusof(how, value)
  if how == "exited" then
    return value
  end
  return SIGNALED + (sys.SIGNALS[value] or 0)
end

local function waitfor(pid)
  while true do
    local got, how, value = sys.waitpid(pid)
    if got then
      if how == "killed" and value == "SIGINT" then
        io.stdout:write("\n") -- after the ^C, as a shell does when its job dies of one
        io.stdout:flush()
      end
      return statusof(how, value)
    elseif value ~= "EINTR" then
      return 1
    end
    -- interrupted (our own ^C): the child had it too; wait on
  end
end

-- POSIX's special builtins: assignments before one stay set; before any other builtin they last
-- only while it runs (IFS=: read a b).
local SPECIAL = {[":"] = true, ["."] = true, exit = true, export = true, set = true, unset = true, source = true}

-- A builtin, run in the shell itself (its redirections, and the assignments before it, only while it
-- runs, but for a special builtin's assignments).
local function runbuiltin(cmd, argv)
  local saved = {}
  for _, assign in ipairs(cmd.assigns) do
    local name = assign.name
    if not SPECIAL[argv[1]] and saved[name] == nil then
      saved[name] = {vars[name]}
    end
    vars[name] = expandword(assign.word, true)[1]
  end
  local function restore()
    for name, old in pairs(saved) do
      vars[name] = old[1]
    end
  end
  local fds, opened = {}, {}
  local ok, why = redirect(cmd, fds, opened)
  local result = 1
  local raised
  if ok then
    local out = fds[1] == nil and 1 or fds[1]
    local err = fds[2] == nil and 2 or fds[2]
    io.stdout:flush()
    local input = fds[0] == nil and 0 or fds[0]
    local done, value = pcall(builtins[argv[1]], argv, out or nil, err or nil, input or nil)
    if done then
      result = value or 0
    elseif type(value) == "table" and value.exit then
      raised = value -- exit: on up to the shell's top, once the files are closed
    else
      say(argv[1] .. ": " .. tostring(type(value) == "table" and value.shell or value))
    end
  else
    say(why)
  end
  for _, fd in ipairs(opened) do
    sys.close(fd)
  end
  restore()
  if raised then
    error(raised, 0)
  end
  return result
end

local function runpipeline(pipeline, background)
  local commands = pipeline.commands
  for _, cmd in ipairs(commands) do
    cmd.argv = {}
    for _, word in ipairs(cmd.words) do
      for _, field in ipairs(expandword(word)) do
        cmd.argv[#cmd.argv + 1] = field
      end
    end
    -- command name [args]: the command itself, past any alias (-p: the default PATH, as ours is)
    while cmd.argv[1] == "command" and cmd.argv[2] and (cmd.argv[2] == "-p" or string.sub(cmd.argv[2], 1, 1) ~= "-") do
      table.remove(cmd.argv, 1)
      if cmd.argv[1] == "-p" then
        table.remove(cmd.argv, 1)
      end
    end
  end
  local first = commands[1]
  -- assignments alone set the shell's variables; a lone redirection makes (or empties) its file
  if #commands == 1 and #first.argv == 0 then
    local before = substitutions
    for _, assign in ipairs(first.assigns) do
      vars[assign.name] = expandword(assign.word, true)[1]
    end
    local fds, opened = {}, {}
    local ok, why = redirect(first, fds, opened)
    for _, fd in ipairs(opened) do
      sys.close(fd)
    end
    if not ok then
      say(why)
      return 1
    end
    return substitutions ~= before and status or 0 -- (a $(...) in it sets the status: its own)
  end
  if #commands == 1 and builtins[first.argv[1]] and not background then
    return runbuiltin(first, first.argv)
  end
  local pids, opened = {}, {}
  local input
  local result = 0
  io.stdout:flush()
  for index, cmd in ipairs(commands) do
    local fds = {}
    if input then
      fds[0] = input
    end
    local r, w
    if index < #commands then
      r, w = sys.pipe()
      fds[1] = w
    end
    local ok, why = redirect(cmd, fds, opened)
    local spawnfds, closed = {}, {}
    for fd, from in pairs(fds) do
      if from == false then
        closed[#closed + 1] = fd
      else
        spawnfds[fd] = from
      end
    end
    if not ok then
      say(why)
      result = 1
    elseif #cmd.argv > 0 then
      local name = cmd.argv[1]
      local env = environment()
      for _, assign in ipairs(cmd.assigns) do
        env[assign.name] = expandword(assign.word, true)[1]
      end
      local ignore = background and {"SIGINT"} or nil
      local pid, code, err
      if builtins[name] then
        -- a builtin in a pipeline (or the background) runs in a child shell, as in a real one
        local quoted = {}
        for k, a in ipairs(cmd.argv) do
          quoted[k] = "'" .. string.gsub(a, "'", "'\\''") .. "'"
        end
        pid, err = sys.spawn("/bin/sh", {"-c", table.concat(quoted, " ")}, {fds = spawnfds, env = env, ignore = ignore})
        code = NOT_RUNNABLE
      else
        local program
        program, code, err = locate(name)
        if program then
          pid, err = sys.spawn(program, {table.unpack(cmd.argv, 2)}, {fds = spawnfds, env = env, ignore = ignore})
          if not pid then
            err, code = name .. ": " .. tostring(err), NOT_RUNNABLE
          end
        end
      end
      if pid then
        pids[#pids + 1] = pid
        if index == #commands then
          result = nil -- its status comes from waiting for it
        end
      else
        -- said where the command's own stderr goes: its redirections are made before it's looked
        -- for (as in a forked child before exec), so "cmd 2> /dev/null" hides "not found" too
        local stderr = spawnfds[2] or (fds[2] == nil and 2 or nil)
        if stderr then
          io.stdout:flush()
          sys.write(stderr, "sh: " .. err .. "\n")
        end
        result = code
      end
    end
    if input then
      sys.close(input)
    end
    if w then
      sys.close(w)
    end
    input = r
  end
  if input then
    sys.close(input)
  end
  for _, fd in ipairs(opened) do
    sys.close(fd)
  end
  if background then
    for _, pid in ipairs(pids) do
      lastbg = pid
      if sys.isatty(0) then
        io.stderr:write("[" .. pid .. "]\n")
      end
    end
    return 0
  end
  local last = 0
  for _, pid in ipairs(pids) do
    last = waitfor(pid)
  end
  return result or last -- the last command's status (its own failure to start, if it didn't)
end

local runscript

-- A list in the background (a && b &): all of it in a child shell, as a real shell forks one for
-- it; its pid is $!. True.
local function background(text)
  io.stdout:flush()
  local pid, why = sys.spawn("/bin/sh", {"-c", text, name0, table.unpack(positional, 1, positional.n)},
    {env = environment(), ignore = {"SIGINT"}})
  if not pid then
    say("/bin/sh: " .. tostring(why))
    status = 1
    return true
  end
  lastbg = pid
  if sys.isatty(0) then
    io.stderr:write("[" .. pid .. "]\n")
  end
  status = 0
  return true
end

-- Runs a line (or a script's text): its status, and whether it was a syntax error (nothing on the
-- line runs then).
local function runline(line)
  local tokens, why, source = lex(line)
  if tokens == INCOMPLETE then
    why = "syntax error: unexpected end of file"
  end
  local lists
  if tokens and tokens ~= INCOMPLETE then
    lists, why = parse(tokens)
  end
  if not lists then
    say(why)
    status = SYNTAX
    return status, true
  end
  for _, list in ipairs(lists) do
    local child = #list.pipelines > 1 and list.background and background(string.sub(source, list.from, list.last))
    local run = true
    for _, pipeline in ipairs(child and {} or list.pipelines) do
      if run then
        local ok, result = pcall(runpipeline, pipeline, list.background)
        if not ok then
          if type(result) == "table" and result.exit then
            error(result, 0)
          end
          say(type(result) == "table" and result.shell or tostring(result))
          if type(result) == "table" and result.fatal and not interactive then
            error({exit = 1}, 0) -- (as POSIX has a non-interactive shell do for ${NAME:?word})
          end
          result = 1
        end
        if pipeline.negate then
          result = result == 0 and 1 or 0
        end
        status = result
      end
      if pipeline.next == "&&" then
        run = status == 0
      elseif pipeline.next == "||" then
        run = status ~= 0
      end
    end
  end
  return status
end

-- ---- builtins -----------------------------------------------------------------------------------

local function write(fd, text)
  sys.write(fd or 1, text)
end

builtins[":"] = function()
  return 0
end

builtins["true"] = function()
  return 0
end

builtins["false"] = function()
  return 1
end

function builtins.cd(argv, out, err)
  local target = argv[2]
  if target == nil then
    target = vars.HOME
    if not target then
      say("cd: HOME not set")
      return 1
    end
  elseif target == "-" then
    target = vars.OLDPWD
    if not target then
      say("cd: OLDPWD not set")
      return 1
    end
    write(out, target .. "\n")
  end
  local before = sys.getcwd()
  local ok, why = sys.chdir(target)
  if not ok then
    say("cd: " .. target .. ": " .. why)
    return 1
  end
  vars.OLDPWD, vars.PWD = before, sys.getcwd()
  return 0
end

function builtins.pwd(argv, out)
  write(out, sys.getcwd() .. "\n")
  return 0
end

function builtins.exit(argv)
  local code = status
  if argv[2] then
    code = math.tointeger(tonumber(argv[2]))
    if not code then
      say("exit: " .. argv[2] .. ": numeric argument required")
      code = SYNTAX
    end
  end
  error({exit = code}, 0)
end

local function quote(value)
  return "'" .. string.gsub(value, "'", "'\\''") .. "'"
end

function builtins.export(argv, out)
  if #argv == 1 then
    local names = {}
    for name in pairs(vars) do
      names[#names + 1] = name
    end
    table.sort(names)
    for _, name in ipairs(names) do
      write(out, "export " .. name .. "=" .. quote(vars[name]) .. "\n")
    end
    return 0
  end
  local result = 0
  for k = 2, #argv do
    local name, value = string.match(argv[k], "^([%a_][%w_]*)=(.*)$")
    if name then
      vars[name] = value
    elseif not string.match(argv[k], "^[%a_][%w_]*$") then
      say("export: `" .. argv[k] .. "': not a valid identifier")
      result = 1
    end
  end
  return result
end

function builtins.set(argv, out)
  local names = {}
  for name in pairs(vars) do
    names[#names + 1] = name
  end
  table.sort(names)
  for _, name in ipairs(names) do
    write(out, name .. "=" .. quote(vars[name]) .. "\n")
  end
  return 0
end

function builtins.unset(argv)
  for k = 2, #argv do
    vars[argv[k]] = nil
  end
  return 0
end

function builtins.alias(argv, out)
  if #argv == 1 then
    local names = {}
    for name in pairs(aliases) do
      names[#names + 1] = name
    end
    table.sort(names)
    for _, name in ipairs(names) do
      write(out, "alias " .. name .. "=" .. quote(aliases[name]) .. "\n")
    end
    return 0
  end
  local result = 0
  for k = 2, #argv do
    local name, value = string.match(argv[k], "^([^=]*)=(.*)$")
    if name and (name == "" or string.find(name, "[%s/$`'\"]")) then
      say("alias: `" .. name .. "': invalid alias name")
      result = 1
    elseif name then
      aliases[name] = value
    elseif aliases[argv[k]] then
      write(out, "alias " .. argv[k] .. "=" .. quote(aliases[argv[k]]) .. "\n")
    else
      say("alias: " .. argv[k] .. ": not found")
      result = 1
    end
  end
  return result
end

function builtins.unalias(argv)
  if #argv == 1 then
    say("unalias: usage: unalias name...")
    return SYNTAX
  end
  local result = 0
  for k = 2, #argv do
    if aliases[argv[k]] then
      aliases[argv[k]] = nil
    else
      say("unalias: " .. argv[k] .. ": not found")
      result = 1
    end
  end
  return result
end

-- read [-r] [NAME...]: a line from stdin into the variables, as POSIX's read: split into fields on
-- IFS (runs of its blanks separate, and each of its other characters ends a field, blanks about it
-- and all; blanks at the ends are dropped), each name a field, the last the rest of the line; REPLY
-- with none. Without -r a backslash keeps the next character from splitting (and a backslash at
-- the line's end joins the next line). Status 1 at end of file.
function builtins.read(argv, out, err, input)
  local raw = argv[2] == "-r"
  local names = {table.unpack(argv, raw and 3 or 2)}
  if #names == 0 then
    names[1] = "REPLY"
  end
  io.stdout:flush()
  -- A line: from the shell's stdin, or a byte at a time from a redirection (so no more is taken).
  local function nextline()
    if not input or input == 0 then
      return io.stdin:read("l")
    end
    local bytes = {}
    while true do
      local c = sys.read(input, 1)
      if not c or c == "" then
        return #bytes > 0 and table.concat(bytes) or nil
      elseif c == "\n" then
        return table.concat(bytes)
      end
      bytes[#bytes + 1] = c
    end
  end
  -- the line's characters, and which were quoted by a backslash
  local chars, quoted = {}, {}
  while true do
    local line = nextline()
    if not line then
      if #chars == 0 then
        return 1
      end
      break
    end
    local k, joined = 1, false
    while k <= #line do
      local c = string.sub(line, k, k)
      if c == "\\" and not raw then
        if k == #line then
          joined = true
          break
        end
        chars[#chars + 1], quoted[#chars + 1] = string.sub(line, k + 1, k + 1), true
        k = k + 2
      else
        chars[#chars + 1] = c
        k = k + 1
      end
    end
    if not joined then
      break
    end
  end
  local ifs = vars.IFS or DEFAULT_IFS
  local function blank(k)
    return not quoted[k] and chars[k] and string.find(" \t\n", chars[k], 1, true) and string.find(ifs, chars[k], 1, true)
  end
  local function delimiter(k)
    return not quoted[k] and chars[k] and string.find(ifs, chars[k], 1, true) and not blank(k)
  end
  local at = 1
  while blank(at) do
    at = at + 1
  end
  for index, name in ipairs(names) do
    if index == #names then
      local last = #chars
      while last >= at and blank(last) do
        last = last - 1
      end
      vars[name] = table.concat(chars, "", at, last)
      break
    end
    local from = at
    while chars[at] and not blank(at) and not delimiter(at) do
      at = at + 1
    end
    vars[name] = table.concat(chars, "", from, at - 1)
    while blank(at) do
      at = at + 1
    end
    if delimiter(at) then
      at = at + 1
      while blank(at) do
        at = at + 1
      end
    end
  end
  return 0
end

function builtins.type(argv, out)
  local result = 0
  for k = 2, #argv do
    local name = argv[k]
    if aliases[name] then
      write(out, name .. " is an alias for " .. aliases[name] .. "\n")
    elseif builtins[name] then
      write(out, name .. " is a shell builtin\n")
    else
      local program = locate(name)
      if program then
        write(out, name .. " is " .. program .. "\n")
      else
        say("type: " .. name .. ": not found")
        result = 1
      end
    end
  end
  return result
end

-- command -v name...: how each would be run (an alias's definition, a builtin's name, a program's
-- path); -V says it in words, as type does. (command name [args] runs it: see runpipeline.)
function builtins.command(argv, out)
  local mode = argv[2]
  if mode ~= "-v" and mode ~= "-V" then
    if mode == nil then
      return 0
    end
    say("command: " .. mode .. ": invalid option")
    say("command: usage: command [-pVv] command [arg ...]")
    return SYNTAX
  end
  if mode == "-V" then
    return builtins.type({"type", table.unpack(argv, 3)}, out)
  end
  local result = 0
  for k = 3, #argv do
    local name = argv[k]
    if aliases[name] then
      write(out, "alias " .. name .. "=" .. quote(aliases[name]) .. "\n")
    elseif builtins[name] then
      write(out, name .. "\n")
    else
      local program = locate(name)
      if program then
        write(out, program .. "\n")
      else
        result = 1
      end
    end
  end
  return result
end

-- . file, source file: runs a file's commands in this shell.
function builtins.source(argv)
  if not argv[2] then
    say(argv[1] .. ": filename argument required")
    return SYNTAX
  end
  local file, why = io.open(argv[2])
  if not file then
    say(argv[1] .. ": " .. why)
    return 1
  end
  local text = file:read("a")
  file:close()
  return runscript(text)
end
builtins["."] = builtins.source

-- ---- scripts and the prompt ---------------------------------------------------------------------

-- Runs a script's text: line by line, a line that goes on (an open quote...) joined with the next.
-- A syntax error stops a script, as it does a real shell's.
function runscript(text)
  local pending = nil
  for line in string.gmatch(text .. (string.sub(text, -1) == "\n" and "" or "\n"), "([^\n]*)\n") do
    pending = pending and pending .. "\n" .. line or line
    if lex(pending) ~= INCOMPLETE then
      local _, broken = runline(pending)
      pending = nil
      if broken then
        return status
      end
    end
  end
  if pending then
    runline(pending) -- (says: unexpected end of file)
  end
  return status
end

local function prompt(ps)
  local cwd = sys.getcwd()
  local home = vars.HOME
  local shown = cwd
  if home and home ~= "/" and (cwd == home or string.sub(cwd, 1, #home + 1) == home .. "/") then
    shown = "~" .. string.sub(cwd, #home + 1)
  end
  return (string.gsub(ps, "\\(.)", function(c)
    if c == "w" then
      return shown
    elseif c == "W" then
      return shown == "/" and "/" or fs.name(shown)
    elseif c == "$" then
      return "$"
    elseif c == "n" then
      return "\n"
    elseif c == "\\" then
      return "\\"
    end
    return "\\" .. c
  end))
end

-- ---- line editing ------------------------------------------------------------------------------
-- At a terminal the shell reads its lines with readline (/lib/readline.lua, as bash does), its
-- completion knowing commands: the first word of a command completes to a builtin, an alias or a
-- program in PATH; any other word (or one with a /) to file names.

local readline = require("readline")

-- Whether the line before a word leaves it the first of a command.
local function commandposition(before)
  before = string.match(before, "^(.-)%s*$")
  return before == "" or string.find(before, "[;|&(`!]$") ~= nil or string.sub(before, -2) == "$("
end

local function completions(before, word)
  if string.find(word, "/", 1, true) or not commandposition(before) then
    return readline.filenames(word)
  end
  local seen, found = {}, {}
  local function add(name)
    if string.sub(name, 1, #word) == word and not seen[name] then
      seen[name] = true
      found[#found + 1] = name
    end
  end
  for name in pairs(builtins) do
    add(name)
  end
  for name in pairs(aliases) do
    add(name)
  end
  for dir in string.gmatch(vars.PATH or "", "[^:]+") do
    for _, entry in ipairs(fs.list(dir) or {}) do
      if entry.type ~= "directory" then
        add(entry.name)
      end
    end
  end
  table.sort(found)
  return found
end

local editor = readline.new({complete = completions})

-- Background jobs that ended, reported before a prompt.
local function reap()
  while true do
    local pid, how, value = sys.waitpid(-1, "nohang")
    if not pid or pid == 0 then
      return
    end
    local s = statusof(how, value)
    io.stderr:write("[" .. pid .. "] " .. (how == "exited" and (s == 0 and "Done" or "Exit " .. s) or value) .. "\n")
  end
end

-- The shell: its exit status (exit's, or its last command's).
local function main(...)
  local args = table.pack(...)
  vars.PS1 = vars.PS1 or DEFAULT_PS1
  vars.PS2 = vars.PS2 or DEFAULT_PS2
  vars.PWD = sys.getcwd()
  if args[1] == "-c" then
    if args[2] == nil then
      say("-c: option requires an argument")
      return SYNTAX
    end
    name0 = args[3] or "sh"
    positional = {n = math.max(args.n - 3, 0), table.unpack(args, 4, args.n)}
    return runscript(args[2])
  elseif args[1] then
    name0 = args[1]
    positional = {n = args.n - 1, table.unpack(args, 2, args.n)}
    local file, why = io.open(args[1])
    if not file then
      say(why)
      return NOT_FOUND
    end
    local text = file:read("a")
    file:close()
    return runscript((string.gsub(text, "^#![^\n]*", "")))
  end
  interactive = sys.isatty(0)
  if interactive then
    sys.signal("SIGINT", function() end) -- ^C: a read returns EINTR; the command in front ends
  end
  -- A line: at a terminal the shell's own editor, else the input's next line; and why not (EINTR).
  local function nextline(ps)
    if interactive then
      return editor:read(prompt(ps))
    end
    local line, _, errno = io.read("l")
    return line, errno
  end
  while true do
    if interactive then
      reap()
    end
    local line, errno = nextline(vars.PS1)
    if line == nil then
      if errno ~= "EINTR" then -- (^C: the line was dropped; a new prompt)
        if interactive then
          io.stdout:write("exit\n")
        end
        return status
      end
    else
      -- a line that goes on: read more (PS2) until it's whole; ^C drops it, end of file ends it
      while lex(line) == INCOMPLETE do
        local more = nextline(vars.PS2)
        if more == nil then
          line = nil
          break
        end
        line = line .. "\n" .. more
      end
      if line then
        if editor.typeahead ~= "" then
          sys.ioctl(0, "TIOCSTI", editor.typeahead) -- what was typed ahead is the command's to read
          editor.typeahead = ""
        end
        runline(line)
      end
    end
  end
end

local ok, result = pcall(main, ...)
io.flushall()
if ok then
  return result
elseif type(result) == "table" and result.exit then
  return result.exit
end
error(result, 0)
