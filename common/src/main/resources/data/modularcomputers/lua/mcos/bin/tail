-- tail [-f] [-n [+]lines] [-c [+]bytes] [-N] [file...]: the last lines (10) or bytes of each file,
-- or of stdin; with +N, from line (or byte) N on. -f follows: once they're shown, it waits and shows
-- what's added to the files, or a file again when it's rewritten (a redstone card's state changing),
-- until it's stopped (^C); not on stdin when it's a pipe, as tail. A file that never ends (a
-- sensor's events) is read, with -f, only as far as it has something now: its last lines of
-- that, then each as it comes.
local sys = require("sys")

local READ_SIZE = 4096

local lines, bytes, from = 10, nil, false
local follow = false
local files = {}
local i = 1
while i <= #arg do
  local word = arg[i]
  local flag, value = string.match(word, "^%-([nc])(.*)$")
  if flag then
    if value == "" then
      i = i + 1
      value = arg[i] or ""
    end
    local plus = string.sub(value, 1, 1) == "+"
    local number = math.tointeger(tonumber(plus and string.sub(value, 2) or value))
    if not number or number < 0 then
      io.stderr:write("tail: invalid number of " .. (flag == "n" and "lines" or "bytes") .. ": '" .. value .. "'\n")
      return 1
    end
    from = plus
    if flag == "n" then
      lines, bytes = number, nil
    else
      bytes = number
    end
  elseif string.match(word, "^%-%d+$") then
    lines = tonumber(string.sub(word, 2))
  elseif word == "-f" then
    follow = true
  elseif string.sub(word, 1, 1) == "-" and #word > 1 then
    io.stderr:write("tail: invalid option -- '" .. string.sub(word, 2, 2) .. "'\n")
    return 1
  else
    files[#files + 1] = word
  end
  i = i + 1
end
if #files == 0 then
  files[1] = "-"
end

local function last(file)
  if bytes then
    local data = file:read("a") or ""
    if from then
      return string.sub(data, math.max(bytes, 1))
    end
    return bytes == 0 and "" or string.sub(data, -bytes)
  end
  local kept, n = {}, 0
  for line in file:lines("L") do
    n = n + 1
    if from then
      if n >= lines then
        io.write(line)
      end
    else
      kept[#kept + 1] = line
      if #kept > lines then
        table.remove(kept, 1) -- (a ring would be cheaper; the lines kept are few)
      end
    end
  end
  return table.concat(kept)
end

-- With -f, a file that isn't a disk's (a device's) gives only what it has now: a stream that never
-- ends (a sensor's events) would keep last() waiting for its end, showing nothing.
local function now(file)
  local fd, data = file.fd, {}
  while next(sys.poll({[fd] = {IN = true}}, 0) or {}) do
    local chunk = sys.read(fd, READ_SIZE)
    if not chunk or chunk == "" then
      break
    end
    data[#data + 1] = chunk
  end
  data = table.concat(data)
  if bytes then
    if from then
      return string.sub(data, math.max(bytes, 1))
    end
    return bytes == 0 and "" or string.sub(data, -bytes)
  end
  local kept, n = {}, 0
  for line in data:gmatch("[^\n]*\n?") do
    if line ~= "" then
      n = n + 1
      if not from or n >= lines then
        kept[#kept + 1] = line
      end
      if not from and #kept > lines then
        table.remove(kept, 1)
      end
    end
  end
  return table.concat(kept)
end

local status = 0
local followed = {} -- {path, file} each file to follow, left open
for index, path in ipairs(files) do
  local file, why = io.stdin, nil
  if path ~= "-" then
    file, why = io.open(path)
    local st = sys.stat(path)
    if file and st and st.type == "directory" then
      file:close()
      file, why = nil, path .. ": Is a directory" -- (its reads would fail: EISDIR)
    end
  end
  if not file then
    io.stderr:write("tail: " .. why .. "\n")
    status = 1
  else
    if #files > 1 then
      io.write(index > 1 and "\n" or "", "==> ", path == "-" and "standard input" or path, " <==\n")
    end
    local st = path ~= "-" and sys.stat(path)
    io.write(follow and st and st.type ~= "file" and now(file) or last(file))
    if follow and file ~= io.stdin then
      followed[#followed + 1] = {path = path, file = file}
    elseif file ~= io.stdin then
      file:close()
    end
  end
end
if #followed == 0 then
  return status
end
-- -f: what the files grow by, the moment it comes (a header when it's another file's than the last
-- shown). Files on a disk or in /tmp are watched (inotify: a disk reports each change made on it);
-- the rest (pipes, /dev files) are waited on with poll, all together. A file rewritten rather than
-- added to (a file grown shorter, or changed with nothing added) is shown again from its start,
-- after "file truncated", as GNU tail does when a file shrinks. A file that's always readable but
-- gives nothing new (a device's attribute: a redstone card's state) is waited on for a change
-- instead (poll's PRI, as a sysfs GPIO value's).
io.stdout:flush()
local shown = followed[#followed].path
local notices = sys.inotify()
local wanted = {[notices] = {IN = true}}
for _, entry in ipairs(followed) do
  local st = sys.stat(entry.path)
  entry.fd = entry.file.fd -- (the descriptor itself: a FILE's end of file is sticky, as glibc's is; tail reads past it)
  entry.disk = st and st.type == "file"
  if entry.disk then
    entry.at = sys.lseek(entry.fd, 0, "cur") or 0
    entry.real = sys.realpath(entry.path) or entry.path
    sys.watch(notices, entry.real)
  else
    wanted[entry.fd] = {IN = true}
  end
end

local function heading(entry)
  if #files > 1 and shown ~= entry.path then
    io.write("\n==> ", entry.path, " <==\n")
    shown = entry.path
  end
end

-- Shows what can be read now: everything to the end of a file (or a device's state), or one read of
-- a stream (another could wait). Whether there was anything.
local function show(entry, stream)
  local any = false
  repeat
    local data = sys.read(entry.fd, READ_SIZE)
    if not data or data == "" then
      break
    end
    any = true
    heading(entry)
    io.write(data)
    entry.at = (entry.at or 0) + #data
  until stream
  return any
end

-- Shown again from its start, as a file that was truncated and written anew.
local function again(entry)
  if sys.lseek(entry.fd, 0, "set") then
    io.stderr:write("tail: ", entry.path, ": file truncated\n")
    entry.at = 0
    show(entry)
  end
end

while true do
  local happened = sys.poll(wanted) or {}
  local changed = {}
  while happened[notices] and (sys.poll({[notices] = {IN = true}}, 0) or {})[notices] do
    local name, path = (sys.read(notices) or ""):match("^(%S+) ?([^\n]*)")
    happened[notices] = name ~= nil
    for _, entry in ipairs(followed) do
      if entry.disk and (name == "OVERFLOW" or path == entry.real) then
        changed[entry] = true
      end
    end
  end
  for _, entry in ipairs(followed) do
    local now = happened[entry.fd]
    if changed[entry] then
      local st = sys.stat(entry.path)
      if st and st.size < entry.at or not show(entry) then
        again(entry)
      end
    elseif now and now.PRI then
      again(entry)
    elseif now and not show(entry, true) then
      -- readable with nothing new: an attribute (wait for a change), or a pipe ended (stop)
      wanted[entry.fd] = not now.HUP and {PRI = true} or nil
    end
  end
  io.stdout:flush()
end
