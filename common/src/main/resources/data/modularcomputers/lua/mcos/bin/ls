-- ls [-1aChlFS] [--color[=WHEN]] [path...]: what's in directories (a file lists itself). On a
-- terminal, names go in columns down then across, as wide as the terminal (as GNU ls), directories
-- in blue; into a pipe or a file, one a line. -1 one a line, -C columns anyway, -l long (type, size,
-- name; a link's target after ->), -h sizes as 1.5K, 12M (GNU's, powers of 1024), -a names starting
-- with a dot too, -F a / after directories, an @ after links, -S by size, largest first (ties by
-- name), as GNU ls's. --color=auto colors on a terminal only (as with no --color), always or
-- --color alone always, never not at all.
local sys = require("sys")
local fs = require("fs")

local GAP = 2 -- spaces between columns
local DEFAULT_WIDTH = 80 -- columns, when the terminal doesn't say
local DIRECTORY_COLOR = "\27[1;34m" -- (dircolors' default for directories)
local LINK_COLOR = "\27[1;36m" -- (and for links)
local RESET = "\27[0m"
local UNITS = {"K", "M", "G", "T"} -- -h's, each 1024 of the last
local KIBI = 1024
local ONE_DECIMAL = 10 -- -h shows a tenth below this many of a unit (1.5K), whole ones from it (12K)
local COLOR_WHEN = {auto = "auto", tty = "auto", ["if-tty"] = "auto", always = "always", yes = "always", force = "always",
  never = "never", no = "never", none = "never"} -- (GNU's words for each)

local flags = {}
local paths = {}
local color = "auto"
for _, word in ipairs(arg) do
  if word:sub(1, 7) == "--color" then
    local when = word:match("^%-%-color=(.+)$")
    if word ~= "--color" and not COLOR_WHEN[when or ""] then
      io.stderr:write("ls: invalid argument '" .. tostring(when or word:sub(8)) .. "' for '--color'\n")
      return 2
    end
    color = when and COLOR_WHEN[when] or "always"
  elseif word:sub(1, 2) == "--" then
    io.stderr:write("ls: unrecognized option '" .. word .. "'\n")
    return 2
  elseif string.sub(word, 1, 1) == "-" and #word > 1 then
    for c in string.gmatch(string.sub(word, 2), ".") do
      if not string.find("1aChlFS", c, 1, true) then
        io.stderr:write("ls: invalid option -- '" .. c .. "'\n")
        return 2
      end
      flags[c] = true
    end
  else
    paths[#paths + 1] = word
  end
end
if #paths == 0 then
  paths[1] = "."
end

local tty = sys.isatty(1)
local colored = color == "always" or color == "auto" and tty
local columns = flags.C or (tty and not flags["1"] and not flags.l)
local width = tty and sys.ioctl(1, "TIOCGWINSZ") or DEFAULT_WIDTH

-- An entry as shown: its text, and how wide it is on the screen (colors take no room).
local function shown(entry)
  local mark = flags.F and (entry.type == "directory" and "/" or entry.type == "link" and "@") or ""
  local text = entry.name .. mark
  local paint = entry.type == "directory" and DIRECTORY_COLOR or entry.type == "link" and LINK_COLOR
  if colored and paint then
    return paint .. text .. RESET, utf8.len(text) or #text
  end
  return text, utf8.len(text) or #text
end

-- Names in columns: as many columns as fit, filled down first.
local function grid(entries)
  local texts, widths = {}, {}
  for i, entry in ipairs(entries) do
    texts[i], widths[i] = shown(entry)
  end
  local n = #entries
  if n == 0 then
    return
  end
  local rows, colwidths
  for tried = n, 1, -1 do
    rows = math.ceil(n / tried)
    local cols = math.ceil(n / rows)
    colwidths = {}
    local total = 0
    for c = 1, cols do
      local widest = 0
      for r = 1, rows do
        local i = (c - 1) * rows + r
        if i <= n and widths[i] > widest then
          widest = widths[i]
        end
      end
      colwidths[c] = widest
      total = total + widest + (c < cols and GAP or 0)
    end
    if total <= width or cols == 1 then
      break
    end
  end
  for r = 1, rows do
    local line = {}
    for c = 1, #colwidths do
      local i = (c - 1) * rows + r
      if i <= n then
        local last = (c == #colwidths) or ((c * rows + r) > n)
        line[#line + 1] = texts[i] .. (last and "" or string.rep(" ", colwidths[c] - widths[i] + GAP))
      end
    end
    io.write(table.concat(line), "\n")
  end
end

-- A size as -h shows it (GNU's): bytes under 1K, else a tenth of a unit under 10 of it, rounded up.
local function human(bytes)
  if bytes < KIBI then
    return tostring(bytes)
  end
  local value, unit = bytes, 0
  while value >= KIBI and unit < #UNITS do
    value, unit = value / KIBI, unit + 1
  end
  if value < ONE_DECIMAL then
    local tenths = math.ceil(value * 10)
    if tenths < ONE_DECIMAL * 10 then
      return string.format("%d.%d%s", tenths // 10, tenths % 10, UNITS[unit])
    end
    value = ONE_DECIMAL
  end
  return string.format("%d%s", math.ceil(value), UNITS[unit])
end

-- An entry's size (a link's own, as -l shows it).
local function size(entry, dir)
  if entry.size then
    return entry.size
  end
  local st = dir and fs.lstat(fs.join(dir, entry.name))
  return st and st.size or 0
end

local function show(entries, dir)
  local visible = {}
  for _, entry in ipairs(entries) do
    if flags.a or string.sub(entry.name, 1, 1) ~= "." then
      visible[#visible + 1] = entry
    end
  end
  if flags.S then
    for _, entry in ipairs(visible) do
      entry.bytes = size(entry, dir)
    end
    table.sort(visible, function(a, b)
      if a.bytes ~= b.bytes then
        return a.bytes > b.bytes
      end
      return a.name < b.name
    end)
  end
  if flags.l then
    for _, entry in ipairs(visible) do
      local st = dir and fs.lstat(fs.join(dir, entry.name)) or entry
      local kind = ({directory = "d", device = "c", fifo = "p", link = "l"})[st and st.type or entry.type] or "-"
      local text = shown(entry)
      local target = st and st.target and " -> " .. st.target or ""
      local bytes = st and st.size or 0
      io.write(string.format("%s %8s %s%s\n", kind, flags.h and human(bytes) or tostring(bytes), text, target))
    end
  elseif columns then
    grid(visible)
  else
    for _, entry in ipairs(visible) do
      io.write((shown(entry)), "\n")
    end
  end
end

local status = 0
local files, dirs = {}, {}
for _, path in ipairs(paths) do
  local st, why = fs.stat(path)
  local link = fs.lstat(path)
  if link and link.type == "link" and (flags.l or not st) then
    st = link -- (-l shows a link named on the command line as itself, as does a link to nothing)
  end
  if not st then
    io.stderr:write("ls: cannot access '" .. path .. "': " .. string.gsub(why, "^.-: ", "") .. "\n")
    status = 2
  elseif st.type == "directory" then
    dirs[#dirs + 1] = path
  else
    files[#files + 1] = {name = path, type = st.type, size = st.size, target = st.target}
  end
end
if #files > 0 then
  show(files)
end
for i, path in ipairs(dirs) do
  if #paths > 1 then
    io.write((#files > 0 or i > 1) and "\n" or "", path, ":\n")
  end
  local entries, err = fs.list(path)
  if entries then
    show(entries, path)
  else
    io.stderr:write("ls: " .. err .. "\n")
    status = 2
  end
end
return status
