-- lsdev [-i]: the devices on the bus, as the kernel knows them (sys.devices: it may be a moment
-- behind a change): each one's name (its /dev file's), type, path (the slot it's in,
-- or - when it's cabled) and label, in bus order; -i its id too.
local sys = require("sys")

local GAP = 2 -- spaces between columns

local ids = false
for _, word in ipairs(arg) do
  if word == "-i" then
    ids = true
  else
    io.stderr:write("lsdev: invalid option '", word, "'\nusage: lsdev [-i]\n")
    return 1
  end
end

-- A row's cells (the id's only with -i).
local function row(name, kind, path, id, label)
  if ids then
    return {name, kind, path, id, label}
  end
  return {name, kind, path, label}
end

local rows = {row("NAME", "TYPE", "PATH", "ID", "LABEL")}
for _, device in ipairs(sys.devices()) do
  rows[#rows + 1] = row(device.name, device.type or "?", device.path or "-", device.id or "-", device.label or "")
end

local widths = {}
for _, cells in ipairs(rows) do
  for c, cell in ipairs(cells) do
    widths[c] = math.max(widths[c] or 0, #cell)
  end
end
for _, cells in ipairs(rows) do
  local out = {}
  for c, cell in ipairs(cells) do
    out[c] = c < #cells and cell .. string.rep(" ", widths[c] - #cell + GAP) or cell
  end
  io.write(table.concat(out), "\n")
end
